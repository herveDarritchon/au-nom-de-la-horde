{
  "name": "warbound",
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "packs:build": "node ./tools/pullYAMLtoLDB.mjs",
    "packs:extract": "node ./tools/pushLDBtoYAML.mjs",
    "packs:repair": "node ./tools/repairPacks.mjs",
    "packs:migrate-assets": "node ./tools/replaceAssetPaths.mjs",
    "packs:audit": "node ./tools/auditAssets.mjs",
    "build": "pnpm packs:audit && pnpm packs:build",
    "test": "node --test",
    "test:coverage": "c8 node --test",
    "check:html-inline": "bash tools/check-inline-html.sh",
    "media:scan": "node ./tools/mediaScanner.mjs",
    "media:convert:images": "node ./tools/convertImages.mjs",
    "media:migrate-refs": "node ./tools/migrateRefs.mjs",
    "media:optimize": "node ./tools/mediaOptimize.mjs",
    "media:optimize:dry-run": "node ./tools/mediaOptimize.mjs --dry-run",
    "media:optimize:audio": "node ./tools/optimizeAudio.mjs --dry-run",
    "media:optimize:audio:write": "node ./tools/optimizeAudio.mjs --write",
    "media:optimize:video": "node ./tools/mediaOptimize.mjs --type video --dry-run",
    "media:optimize:video:write": "node ./tools/mediaOptimize.mjs --type video --write",
    "media:music:refs:audit": "node ./tools/auditMusicPaths.mjs",
    "media:music:refs:check": "node ./tools/auditMusicPaths.mjs --check",
    "media:music:refs:write": "node ./tools/auditMusicPaths.mjs --write",
    "media:music:module:check": "node ./tools/checkMusicIntegration.mjs",
    "media:music:module:fix": "node ./tools/checkMusicIntegration.mjs --fix",
    "media:music:assets:check": "node ./tools/checkMusicIntegration.mjs --require-audio-root",
    "media:music:lfs:status": "node ./tools/checkMusicLfs.mjs",
    "media:music:verify": "pnpm media:music:refs:check && pnpm media:music:module:check",
    "build:verified": "pnpm media:music:verify && pnpm build && pnpm test"
  },
  "devDependencies": {
    "@foundryvtt/foundryvtt-cli": "^3.0.4",
    "c8": "^12.0.0",
    "sharp": "^0.35.5"
  }
}
